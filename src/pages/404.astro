---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---

<Base title={`Page not found · ${site.name}`}>
  <main class="wrap notfound">
    <p class="label">404</p>
    <h1>This page doesn't exist.</h1>
    <p><a class="link" href="/">← Back to {site.name}</a></p>
  </main>
</Base>
